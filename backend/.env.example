# MailForensics Configuration Template (Safe Example)
APP_NAME=MailForensics
APP_VERSION=1.0.0
TAGLINE=Analyze. Investigate. Explain.
ENVIRONMENT=production

# Security & Tokens (Change in production!)
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Local SQLite (default for dev):
DATABASE_URL=sqlite:///./mailforensics.db
# Production PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mailforensics

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Processing Mode: local (synchronous) or celery (distributed queue)
PROCESSING_MODE=local

# Defensive Security & External Probing
ENABLE_LIVE_DNS_LOOKUPS=False
STORAGE_DIR=./storage
UPLOAD_DIR=./uploads

# Threat Intelligence API Keys (Leave blank if not configured)
VT_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
